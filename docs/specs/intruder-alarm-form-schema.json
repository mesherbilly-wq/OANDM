    "measurement": "Numeric value, unit, measurement conditions and instrument reference",
    "signal_test_list": "Signal name, trigger, expected result, sent/received times, ARC acknowledgement, outcome and linked issue",
    "training_topic_list": "Topic, applicability, demonstrated/explained/practised status, notes; seed setting, unsetting, part setting, reset, faults, omissions, hold-up, false alarms, logbook, support",
    "document_manifest": "Document ID, title, revision, date, attachment ID, availability status and omission reason"
  },
  "implementationNotes": [
    "IDs in repeatable sections are scoped to their row UUID.",
    "Required fields apply only to active sections; conditional validation rules in accompanying specification override blanket required flags.",
    "Unknown / not verified is valid capture, never automatic evidence of compliance.",
    "Technical test procedures, limits and applicability must come from an approved versioned standards profile; this schema deliberately supplies no invented limits.",
    "Transfer section must also be enabled whenever providers change in any work route.",
    "No live passwords, PINs, installer codes or signalling secrets in forms or generated general O&M packs."
  ],
  "integration": {
    "provider": "simpro",
    "mode": "read_only_import",
    "specification": "simpro-import-and-as-fitted-specification.md",
